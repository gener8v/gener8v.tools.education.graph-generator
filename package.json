{
  "name": "@gener8v/graph-generator",
  "version": "0.0.0",
  "description": "Turn one JSON description of a mathematical graph or figure into a React component, for curricular materials.",
  "keywords": [
    "react",
    "svg",
    "graph",
    "math",
    "education",
    "number-line",
    "geometry",
    "json-schema"
  ],
  "license": "MIT",
  "author": "gener8v",
  "homepage": "https://gener8v.github.io/gener8v.tools.education.graph-generator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gener8v/gener8v.tools.education.graph-generator.git"
  },
  "bugs": {
    "url": "https://github.com/gener8v/gener8v.tools.education.graph-generator/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "files": [
    "dist"
  ],
  "bin": {
    "graph-generator": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./tool": {
      "types": "./dist/tool/index.d.ts",
      "default": "./dist/tool/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "default": "./dist/export/index.js"
    },
    "./circle": {
      "types": "./dist/circle.d.ts",
      "default": "./dist/circle.js"
    },
    "./pictograph": {
      "types": "./dist/pictograph.d.ts",
      "default": "./dist/pictograph.js"
    },
    "./line-graph": {
      "types": "./dist/line-graph.d.ts",
      "default": "./dist/line-graph.js"
    },
    "./bar-graph": {
      "types": "./dist/bar-graph.d.ts",
      "default": "./dist/bar-graph.js"
    },
    "./ruler": {
      "types": "./dist/ruler.d.ts",
      "default": "./dist/ruler.js"
    },
    "./number-line": {
      "types": "./dist/number-line.d.ts",
      "default": "./dist/number-line.js"
    },
    "./xy-graph": {
      "types": "./dist/xy-graph.d.ts",
      "default": "./dist/xy-graph.js"
    },
    "./square": {
      "types": "./dist/square.d.ts",
      "default": "./dist/square.js"
    },
    "./triangle": {
      "types": "./dist/triangle.d.ts",
      "default": "./dist/triangle.js"
    },
    "./cube": {
      "types": "./dist/cube.d.ts",
      "default": "./dist/cube.js"
    },
    "./cylinder": {
      "types": "./dist/cylinder.d.ts",
      "default": "./dist/cylinder.js"
    },
    "./xyz-graph": {
      "types": "./dist/xyz-graph.d.ts",
      "default": "./dist/xyz-graph.js"
    },
    "./schema.json": "./dist/schema.json",
    "./vocabulary.json": "./dist/vocabulary.json",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "generate": "tsx scripts/generate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "tsx tests/smoke/run.ts",
    "bench": "vitest bench --run --reporter=verbose",
    "size": "size-limit",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile esm-only",
    "check:deps": "tsx scripts/check-dependencies.ts",
    "check:changesets": "tsx scripts/check-changesets.ts",
    "changeset": "changeset",
    "check:dist": "tsx scripts/check-dist.ts",
    "check:images": "tsx scripts/check-image-licenses.ts",
    "docs": "storybook dev -p 6006 --disable-telemetry --no-version-updates",
    "docs:build": "storybook build -o storybook-static --disable-telemetry"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "~22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.1.0",
    "storybook": "10.6.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild": "^0.28.2",
      "launch-editor": "^2.14.2"
    }
  }
}
