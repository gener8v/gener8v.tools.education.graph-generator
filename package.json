{
  "name": "@gener8v/graph-generator",
  "version": "0.0.0",
  "description": "Turn one JSON description of a mathematical graph or figure into a React component, for curricular materials.",
  "keywords": [
    "react",
    "svg",
    "graph",
    "math",
    "education",
    "number-line",
    "geometry",
    "json-schema"
  ],
  "license": "MIT",
  "author": "gener8v",
  "homepage": "https://gener8v.github.io/gener8v.tools.education.graph-generator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gener8v/gener8v.tools.education.graph-generator.git"
  },
  "bugs": {
    "url": "https://github.com/gener8v/gener8v.tools.education.graph-generator/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./tool": {
      "types": "./dist/tool/index.d.ts",
      "default": "./dist/tool/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "default": "./dist/export/index.js"
    },
    "./schema.json": "./dist/schema.json",
    "./vocabulary.json": "./dist/vocabulary.json",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "size": "size-limit",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile esm-only",
    "check:deps": "tsx scripts/check-dependencies.ts",
    "check:changesets": "tsx scripts/check-changesets.ts",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
